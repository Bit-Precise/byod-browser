diff --git a/chrome/browser/resources/settings/people_page/people_page.html b/chrome/browser/resources/settings/people_page/people_page.html
--- a/chrome/browser/resources/settings/people_page/people_page.html
+++ b/chrome/browser/resources/settings/people_page/people_page.html
@@ -73,7 +73,26 @@
     </style>
     <settings-section page-title="$i18n{peoplePageTitle}">
       <div>
+
+<if expr="not is_chromeos">
+        <!--
+          BYOD accounts are separate from Chromium's Google identity. Keep
+          this entry point visible regardless of Sync/GAIA state so users can
+          establish the Connect session used by the exam flow.
+        -->
+        <div id="byod-connect-login" class="cr-row first two-line">
+          <div class="flex cr-padded-text">
+            <div>$i18n{byodConnectSignIn}</div>
+            <div class="secondary">
+              $i18n{byodConnectSignInDescription}
+            </div>
+          </div>
+          <cr-button class="action-button" on-click="onConnectLoginClick_">
+            $i18n{byodConnectSignIn}
+          </cr-button>
+        </div>
+</if>
 
 <if expr="not is_chromeos">
         <template is="dom-if" if="[[shouldShowSyncAccountControl_(
             syncStatus.syncSystemEnabled, syncStatus.signedInStatus)]]" restamp>
diff --git a/chrome/browser/resources/settings/people_page/people_page.ts b/chrome/browser/resources/settings/people_page/people_page.ts
--- a/chrome/browser/resources/settings/people_page/people_page.ts
+++ b/chrome/browser/resources/settings/people_page/people_page.ts
@@ -343,7 +343,15 @@ export class SettingsPeoplePageElement extends SettingsPeoplePageElementBase {
     Router.getInstance().navigateTo(routes.ACCOUNT);
   }
 
+  /** Opens the BYOD Connect login page in this settings tab. */
+  private onConnectLoginClick_() {
+    // Ask the browser process to navigate. A renderer-initiated transition
+    // from chrome://settings to the custom grips:// scheme is blocked by the
+    // child-process security policy and becomes about:blank#blocked.
+    this.syncBrowserProxy_.startSignIn(ChromeSigninAccessPoint.SETTINGS);
+  }
+
   private onGoogleServicesClick_() {
     Router.getInstance().navigateTo(routes.GOOGLE_SERVICES);
   }
 
