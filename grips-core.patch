diff --git a/chrome/browser/resources/grips/workspaces.ts b/chrome/browser/resources/grips/workspaces.ts
new file mode 100644
index 0000000..be57f5d
--- /dev/null
+++ b/chrome/browser/resources/grips/workspaces.ts
@@ -0,0 +1,231 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import type {Connector, Workspace} from './grips.mojom-webui.js';
+import {WorkspacesPageHandlerFactory, WorkspacesPageHandlerRemote} from './grips.mojom-webui.js';
+
+const handler = new WorkspacesPageHandlerRemote();
+WorkspacesPageHandlerFactory.getRemote().createPageHandler(
+    handler.$.bindNewPipeAndPassReceiver());
+
+const loading = document.querySelector<HTMLElement>('#loading')!;
+const errorBox = document.querySelector<HTMLElement>('#error')!;
+const workspaceList = document.querySelector<HTMLElement>('#workspace-list')!;
+const workspaceOverview = document.querySelector<HTMLElement>('#workspace-overview')!;
+const connectorsView = document.querySelector<HTMLElement>('#connectors-view')!;
+const workspaceNav = document.querySelector<HTMLElement>('#workspace-nav')!;
+const logoutButton = document.querySelector<HTMLButtonElement>('#logout')!;
+
+let workspaces: Workspace[] = [];
+let pollTimer: number|undefined;
+
+function showError(message: string, status = 0) {
+  if (status === 401) {
+    window.location.href = 'grips://login/';
+    return;
+  }
+  errorBox.textContent = message;
+  errorBox.hidden = false;
+  loading.hidden = true;
+}
+
+function clearViews() {
+  workspaceList.hidden = true;
+  workspaceOverview.hidden = true;
+  connectorsView.hidden = true;
+  errorBox.hidden = true;
+  if (pollTimer !== undefined) {
+    window.clearInterval(pollTimer);
+    pollTimer = undefined;
+  }
+}
+
+function navigate(path: string, replace = false) {
+  if (replace) {
+    history.replaceState({}, '', path);
+  } else {
+    history.pushState({}, '', path);
+  }
+  void renderRoute();
+}
+
+function workspacePath(workspace: Workspace, suffix = '') {
+  return `/${encodeURIComponent(workspace.id)}${suffix}`;
+}
+
+function renderNav(selectedId?: string) {
+  workspaceNav.replaceChildren();
+  for (const workspace of workspaces) {
+    const button = document.createElement('button');
+    button.className = workspace.id === selectedId ? 'nav-item selected' : 'nav-item';
+    button.textContent = workspace.name || workspace.id;
+    button.addEventListener('click', () => navigate(workspacePath(workspace)));
+    workspaceNav.appendChild(button);
+  }
+}
+
+function renderWorkspaceList() {
+  clearViews();
+  renderNav();
+  workspaceList.hidden = false;
+  workspaceList.replaceChildren();
+
+  const heading = document.createElement('div');
+  heading.className = 'page-heading';
+  const title = document.createElement('h1');
+  title.textContent = 'Workspaces';
+  const subtitle = document.createElement('p');
+  subtitle.className = 'muted';
+  subtitle.textContent = 'Your personal compute networks';
+  heading.append(title, subtitle);
+  workspaceList.appendChild(heading);
+
+  const grid = document.createElement('div');
+  grid.className = 'card-grid';
+  if (workspaces.length === 0) {
+    const empty = document.createElement('div');
+    empty.className = 'empty-state';
+    empty.textContent = 'No workspaces are available for this account.';
+    grid.appendChild(empty);
+  }
+  for (const workspace of workspaces) {
+    const card = document.createElement('button');
+    card.className = 'workspace-card';
+    const name = document.createElement('strong');
+    name.textContent = workspace.name || 'Untitled workspace';
+    const id = document.createElement('span');
+    id.textContent = workspace.id;
+    card.append(name, id);
+    card.addEventListener('click', () => navigate(workspacePath(workspace)));
+    grid.appendChild(card);
+  }
+  workspaceList.appendChild(grid);
+}
+
+function renderOverview(workspace: Workspace) {
+  clearViews();
+  renderNav(workspace.id);
+  workspaceOverview.hidden = false;
+  workspaceOverview.replaceChildren();
+
+  const title = document.createElement('h1');
+  title.textContent = workspace.name;
+  const id = document.createElement('p');
+  id.className = 'muted mono';
+  id.textContent = workspace.id;
+  const actions = document.createElement('div');
+  actions.className = 'card-grid';
+  const connectors = document.createElement('button');
+  connectors.className = 'workspace-card';
+  const label = document.createElement('strong');
+  label.textContent = 'Connectors';
+  const detail = document.createElement('span');
+  detail.textContent = 'Machines exposed to this workspace';
+  connectors.append(label, detail);
+  connectors.addEventListener('click', () =>
+    navigate(workspacePath(workspace, '/connectors')));
+  actions.appendChild(connectors);
+  workspaceOverview.append(title, id, actions);
+}
+
+function connectorCard(connector: Connector) {
+  const card = document.createElement('article');
+  card.className = 'connector-card';
+  const header = document.createElement('div');
+  header.className = 'connector-header';
+  const name = document.createElement('strong');
+  name.textContent = connector.name || connector.exeId;
+  const status = document.createElement('span');
+  status.className = connector.isOnline ? 'status online' : 'status offline';
+  status.textContent = connector.isOnline ? 'Online' : 'Offline';
+  header.append(name, status);
+  const description = document.createElement('p');
+  description.className = 'muted';
+  description.textContent = connector.description || 'No description';
+  const meta = document.createElement('dl');
+  for (const [label, value] of [
+    ['ID', connector.exeId],
+    ['OS', connector.os],
+    ['Codex', connector.codexVersion],
+    ['IP', connector.clientIp],
+    ['Last seen', connector.lastSeenAt],
+  ]) {
+    if (!value) {
+      continue;
+    }
+    const dt = document.createElement('dt');
+    dt.textContent = label;
+    const dd = document.createElement('dd');
+    dd.textContent = value;
+    meta.append(dt, dd);
+  }
+  card.append(header, description, meta);
+  return card;
+}
+
+async function renderConnectors(workspace: Workspace) {
+  clearViews();
+  renderNav(workspace.id);
+  connectorsView.hidden = false;
+  connectorsView.replaceChildren();
+  const heading = document.createElement('div');
+  heading.className = 'page-heading';
+  const title = document.createElement('h1');
+  title.textContent = 'Connectors';
+  const back = document.createElement('button');
+  back.className = 'secondary';
+  back.textContent = 'Workspace overview';
+  back.addEventListener('click', () => navigate(workspacePath(workspace)));
+  heading.append(title, back);
+  const list = document.createElement('div');
+  list.className = 'connector-list';
+  list.textContent = 'Loading connectors...';
+  connectorsView.append(heading, list);
+
+  const refresh = async () => {
+    const {connectors, error} = await handler.listConnectors(workspace.id);
+    if (error) {
+      showError(error.message, error.status);
+      return;
+    }
+    list.replaceChildren();
+    if (connectors.length === 0) {
+      const empty = document.createElement('div');
+      empty.className = 'empty-state';
+      empty.textContent = 'No connectors are registered in this workspace.';
+      list.appendChild(empty);
+      return;
+    }
+    for (const connector of connectors) {
+      list.appendChild(connectorCard(connector));
+    }
+  };
+  await refresh();
+  pollTimer = window.setInterval(() => {
+    if (document.visibilityState === 'visible') {
+      void refresh();
+    }
+  }, 10_000);
+}
+
+async function renderRoute() {
+  const segments = location.pathname.split('/').filter(Boolean)
+      .map(segment => decodeURIComponent(segment));
+  if (segments.length === 0) {
+    renderWorkspaceList();
+    return;
+  }
+  const workspace = workspaces.find(item => item.id === segments[0]);
+  if (!workspace) {
+    showError('Workspace not found');
+    return;
+  }
+  let tab = segments[1] || '';
+  if (tab === 'executors') {
+    tab = 'connectors';
+    navigate(workspacePath(workspace, '/connectors'), true);
+    return;
+  }
+  if (tab === 'connectors') {
+    await renderConnectors(workspace);
+    return;
+  }
+  renderOverview(workspace);
+}
+
+async function initialize() {
+  const response = await handler.listWorkspaces();
+  loading.hidden = true;
+  if (response.error) {
+    showError(response.error.message, response.error.status);
+    return;
+  }
+  workspaces = response.workspaces;
+  await renderRoute();
+}
+
+logoutButton.addEventListener('click', async () => {
+  logoutButton.disabled = true;
+  const {error} = await handler.logout();
+  logoutButton.disabled = false;
+  if (error) {
+    showError(error.message, error.status);
+    return;
+  }
+  window.location.href = 'grips://login/';
+});
+
+window.addEventListener('popstate', () => void renderRoute());
+void initialize();
diff --git a/chrome/browser/resources/grips/grips.css b/chrome/browser/resources/grips/grips.css
