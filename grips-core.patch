@@ -0,0 +1,280 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/grips/grips_page_handlers.h"
+
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_util.h"
+#include "base/values.h"
+#include "content/public/browser/open_url_params.h"
+#include "content/public/browser/web_contents.h"
+#include "net/base/escape.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition.h"
+
+namespace grips {
+namespace {
+
+bool IsSuccessful(const AgentServerClient::Response& response) {
+  return response.error.empty() && response.http_status >= 200 &&
+         response.http_status < 300;
+}
+
+mojom::ApiErrorPtr MakeError(const AgentServerClient::Response& response,
+                             std::string_view fallback) {
+  auto error = mojom::ApiError::New();
+  error->status = response.http_status;
+  error->message = response.error.empty() ? std::string(fallback)
+                                           : response.error;
+  return error;
+}
+
+std::string StringField(const base::Value::Dict& value,
+                        std::string_view key) {
+  const std::string* result = value.FindString(key);
+  return result ? *result : std::string();
+}
+
+bool IsSafeIdentifier(std::string_view value) {
+  if (value.empty() || value.size() > 128) {
+    return false;
+  }
+  for (char c : value) {
+    if (!base::IsAsciiAlphaNumeric(c) && c != '-' && c != '_' && c != '.') {
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace
+
+LoginPageHandler::LoginPageHandler(
+    mojo::PendingReceiver<mojom::LoginPageHandler> receiver,
+    Profile* profile,
+    content::WebContents* web_contents)
+    : web_contents_(web_contents),
+      client_(profile),
+      receiver_(this, std::move(receiver)) {}
+
+LoginPageHandler::~LoginPageHandler() = default;
+
+void LoginPageHandler::GetLoginConfig(GetLoginConfigCallback callback) {
+  client_.Get("/api/auth/oidc/providers",
+              base::BindOnce(&LoginPageHandler::OnLoginConfig,
+                             weak_ptr_factory_.GetWeakPtr(),
+                             std::move(callback)));
+}
+
+void LoginPageHandler::OnLoginConfig(
+    GetLoginConfigCallback callback,
+    AgentServerClient::Response response) {
+  auto config = mojom::LoginConfig::New();
+  config->server_origin = client_.server_origin().spec();
+  if (!IsSuccessful(response) || !response.body ||
+      !response.body->is_dict()) {
+    std::move(callback).Run(
+        std::move(config),
+        MakeError(response, "Failed to load login configuration"));
+    return;
+  }
+
+  const base::Value::Dict& body = response.body->GetDict();
+  config->password_auth = body.FindBool("password_auth").value_or(false);
+  if (const base::Value::List* providers = body.FindList("providers")) {
+    for (const base::Value& provider : *providers) {
+      if (provider.is_string()) {
+        config->providers.push_back(provider.GetString());
+      }
+    }
+  }
+  std::move(callback).Run(std::move(config), nullptr);
+}
+
+void LoginPageHandler::CheckSession(CheckSessionCallback callback) {
+  client_.Get("/api/auth/check",
+              base::BindOnce(&LoginPageHandler::OnAuthCheck,
+                             weak_ptr_factory_.GetWeakPtr(),
+                             std::move(callback)));
+}
+
+void LoginPageHandler::OnAuthCheck(
+    CheckSessionCallback callback,
+    AgentServerClient::Response response) {
+  if (response.http_status == 401) {
+    std::move(callback).Run(false, std::string(), nullptr);
+    return;
+  }
+  if (!IsSuccessful(response)) {
+    std::move(callback).Run(
+        false, std::string(),
+        MakeError(response, "Failed to check AgentServer session"));
+    return;
+  }
+  client_.Get("/api/auth/me",
+              base::BindOnce(&LoginPageHandler::OnCurrentUser,
+                             weak_ptr_factory_.GetWeakPtr(),
+                             std::move(callback)));
+}
+
+void LoginPageHandler::OnCurrentUser(
+    CheckSessionCallback callback,
+    AgentServerClient::Response response) {
+  if (!IsSuccessful(response) || !response.body ||
+      !response.body->is_dict()) {
+    std::move(callback).Run(
+        false, std::string(),
+        MakeError(response, "Failed to load current user"));
+    return;
+  }
+  std::move(callback).Run(
+      true, StringField(response.body->GetDict(), "email"), nullptr);
+}
+
+void LoginPageHandler::Login(const std::string& email,
+                             const std::string& password,
+                             LoginCallback callback) {
+  if (email.empty() || password.empty() || email.size() > 320 ||
+      password.size() > 4096) {
+    auto error = mojom::ApiError::New();
+    error->status = 400;
+    error->message = "Email and password are required";
+    std::move(callback).Run(std::move(error));
+    return;
+  }
+  base::Value::Dict body;
+  body.Set("email", email);
+  body.Set("password", password);
+  client_.Post("/api/auth/login", std::move(body),
+               base::BindOnce(&LoginPageHandler::OnLogin,
+                              weak_ptr_factory_.GetWeakPtr(),
+                              std::move(callback)));
+}
+
+void LoginPageHandler::OnLogin(LoginCallback callback,
+                               AgentServerClient::Response response) {
+  if (!IsSuccessful(response)) {
+    std::move(callback).Run(MakeError(response, "Login failed"));
+    return;
+  }
+  std::move(callback).Run(nullptr);
+}
+
+void LoginPageHandler::OpenOidcLogin(
+    const std::string& provider,
+    OpenOidcLoginCallback callback) {
+  if (!IsSafeIdentifier(provider) || provider.size() > 64) {
+    auto error = mojom::ApiError::New();
+    error->status = 400;
+    error->message = "Invalid identity provider";
+    std::move(callback).Run(std::move(error));
+    return;
+  }
+  GURL url = client_.server_origin().Resolve(base::StrCat(
+      {"/api/auth/oidc/", net::EscapePath(provider), "/login"}));
+  content::OpenURLParams params(url, content::Referrer(),
+                                WindowOpenDisposition::NEW_FOREGROUND_TAB,
+                                ui::PAGE_TRANSITION_LINK,
+                                /*is_renderer_initiated=*/false);
+  web_contents_->OpenURL(params, {});
+  std::move(callback).Run(nullptr);
+}
+
+WorkspacesPageHandler::WorkspacesPageHandler(
+    mojo::PendingReceiver<mojom::WorkspacesPageHandler> receiver,
+    Profile* profile)
+    : client_(profile), receiver_(this, std::move(receiver)) {}
+
+WorkspacesPageHandler::~WorkspacesPageHandler() = default;
+
+void WorkspacesPageHandler::ListWorkspaces(
+    ListWorkspacesCallback callback) {
+  client_.Get("/api/workspaces",
+              base::BindOnce(&WorkspacesPageHandler::OnListWorkspaces,
+                             weak_ptr_factory_.GetWeakPtr(),
+                             std::move(callback)));
+}
+
+void WorkspacesPageHandler::OnListWorkspaces(
+    ListWorkspacesCallback callback,
+    AgentServerClient::Response response) {
+  std::vector<mojom::WorkspacePtr> result;
+  if (!IsSuccessful(response) || !response.body ||
+      !response.body->is_list()) {
+    std::move(callback).Run(
+        std::move(result),
+        MakeError(response, "Failed to load workspaces"));
+    return;
+  }
+  for (const base::Value& item : response.body->GetList()) {
+    if (!item.is_dict()) {
+      continue;
+    }
+    const base::Value::Dict& value = item.GetDict();
+    std::string id = StringField(value, "id");
+    if (id.empty()) {
+      continue;
+    }
+    auto workspace = mojom::Workspace::New();
+    workspace->id = std::move(id);
+    workspace->name = StringField(value, "name");
+    workspace->created_at = StringField(value, "created_at");
+    workspace->updated_at = StringField(value, "updated_at");
+    result.push_back(std::move(workspace));
+  }
+  std::move(callback).Run(std::move(result), nullptr);
+}
+
+void WorkspacesPageHandler::ListConnectors(
+    const std::string& workspace_id,
+    ListConnectorsCallback callback) {
+  if (!IsSafeIdentifier(workspace_id)) {
+    auto error = mojom::ApiError::New();
+    error->status = 400;
+    error->message = "Invalid workspace identifier";
+    std::move(callback).Run({}, std::move(error));
+    return;
+  }
+  client_.Get(
+      base::StrCat({"/api/workspaces/", net::EscapePath(workspace_id),
+                    "/executors"}),
+      base::BindOnce(&WorkspacesPageHandler::OnListConnectors,
+                     weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void WorkspacesPageHandler::OnListConnectors(
+    ListConnectorsCallback callback,
+    AgentServerClient::Response response) {
+  std::vector<mojom::ConnectorPtr> result;
+  if (!IsSuccessful(response) || !response.body ||
+      !response.body->is_list()) {
+    std::move(callback).Run(
+        std::move(result),
+        MakeError(response, "Failed to load connectors"));
+    return;
+  }
+  for (const base::Value& item : response.body->GetList()) {
+    if (!item.is_dict()) {
+      continue;
+    }
+    const base::Value::Dict& value = item.GetDict();
+    std::string exe_id = StringField(value, "exe_id");
+    if (exe_id.empty()) {
+      continue;
+    }
+    auto connector = mojom::Connector::New();
+    connector->exe_id = std::move(exe_id);
+    connector->name = StringField(value, "name");
+    connector->description = StringField(value, "description");
+    connector->is_default = value.FindBool("is_default").value_or(false);
+    connector->is_online = value.FindBool("is_online").value_or(false);
+    connector->last_seen_at = StringField(value, "last_seen_at");
+    connector->client_ip = StringField(value, "client_ip");
+    connector->os = StringField(value, "os");
+    connector->codex_version = StringField(value, "codex_version");
+    connector->connected_at = StringField(value, "connected_at");
+    connector->disconnected_at = StringField(value, "disconnected_at");
+    result.push_back(std::move(connector));
+  }
+  std::move(callback).Run(std::move(result), nullptr);
+}
+
+void WorkspacesPageHandler::Logout(LogoutCallback callback) {
+  client_.PostEmpty(
+      "/api/auth/logout",
+      base::BindOnce(&WorkspacesPageHandler::OnLogout,
+                     weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void WorkspacesPageHandler::OnLogout(
+    LogoutCallback callback,
+    AgentServerClient::Response response) {
+  if (!IsSuccessful(response)) {
+    std::move(callback).Run(MakeError(response, "Logout failed"));
+    return;
+  }
+  std::move(callback).Run(nullptr);
+}
+
+}  // namespace grips
