diff --git a/chrome/browser/ui/webui/grips/grips_url_handler.cc b/chrome/browser/ui/webui/grips/grips_url_handler.cc
--- a/chrome/browser/ui/webui/grips/grips_url_handler.cc
+++ b/chrome/browser/ui/webui/grips/grips_url_handler.cc
@@ -19,13 +19,13 @@ GURL ErrorURL() {
 }
 
 bool IsValidPublicExamEntry(const GURL& url) {
-  if (!url.is_valid() || url.host_piece() != chrome::kGripsTrustedExamHost ||
+  if (!url.is_valid() || url.host() != chrome::kGripsTrustedExamHost ||
       url.has_username() || url.has_password() || url.has_port() ||
       url.has_ref()) {
     return false;
   }
 
   // A concrete exam path is required. This deliberately rejects a bare
   // domain so discovery cannot silently select an exam on the user's behalf.
-  return !url.path_piece().empty() && url.path_piece() != "/";
+  return !url.path().empty() && url.path() != "/";
 }
@@ -41,6 +41,6 @@ bool HandleGripsExamURL(GURL* url,
 
   // grips://exam/ is the one fixed privileged WebUI origin. Never rewrite it.
-  if (url->host_piece() == chrome::kGripsExamHost) {
+  if (url->host() == chrome::kGripsExamHost) {
     return false;
   }
 
