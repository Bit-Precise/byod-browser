import("//ui/webui/resources/tools/build_webui.gni")

build_webui("build") {
  grd_prefix = "grips"
  # Only the narrow native-control bridge remains in Chromium. The student
  # UI is served dynamically by byod-server over HTTPS.
  static_files = [
    "bridge.html",
    "bridge.css",
    "login.html",
  ]
  # Keep only the small legacy login helper; the exam UI itself is never
  # compiled into Chromium and is fetched from https://exam.cs.ac.cn.
  ts_files = [
    "bridge.ts",
    "login.ts",
  ]
  ts_composite = true
  ts_deps = [ "//ui/webui/resources/js:build_ts" ]
}
