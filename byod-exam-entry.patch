diff --git a/chrome/browser/resources/grips/exam.ts b/chrome/browser/resources/grips/exam.ts
new file mode 100644
--- /dev/null
+++ b/chrome/browser/resources/grips/exam.ts
@@ -0,0 +1,44 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+const title = document.querySelector<HTMLElement>('#title')!;
+const message = document.querySelector<HTMLElement>('#message')!;
+const targetSection = document.querySelector<HTMLElement>('#target-section')!;
+const targetElement = document.querySelector<HTMLElement>('#target')!;
+const errorElement = document.querySelector<HTMLElement>('#error')!;
+const status = document.querySelector<HTMLElement>('#status')!;
+
+function showInvalidLink() {
+  title.textContent = 'Invalid exam link';
+  message.textContent =
+      'The browser did not start an exam session and remains in normal mode.';
+  errorElement.hidden = false;
+  targetSection.hidden = true;
+  status.textContent = 'No restrictions are active';
+}
+
+const params = new URLSearchParams(window.location.search);
+const target = params.get('target');
+if (params.has('error') || !target) {
+  showInvalidLink();
+} else {
+  try {
+    const parsed = new URL(target);
+    if (parsed.protocol !== 'https:' ||
+        parsed.hostname !== 'exam.cs.ac.cn' || parsed.port !== '' ||
+        parsed.pathname === '/') {
+      showInvalidLink();
+    } else {
+      title.textContent = 'Exam link recognized';
+      message.textContent =
+          'The browser is still in normal mode. No device restrictions have been applied.';
+      targetElement.textContent = parsed.href;
+      targetSection.hidden = false;
+      errorElement.hidden = true;
+      status.textContent = 'Ready for OIDC and signed policy integration';
+    }
+  } catch {
+    showInvalidLink();
+  }
+}
diff --git a/chrome/browser/resources/grips/grips.css b/chrome/browser/resources/grips/grips.css
new file mode 100644
