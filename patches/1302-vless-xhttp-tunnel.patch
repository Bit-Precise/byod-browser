+      byod_tunnel_enabled_ &&
+      std::find(byod_tunnel_hosts_.begin(), byod_tunnel_hosts_.end(),
+                target.host()) != byod_tunnel_hosts_.end();
+  return std::make_unique<ByodXHTTPStreamSocket>(
+      allowed ? byod_xhttp_ : nullptr, target);
 }
 
