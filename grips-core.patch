@@ -0,0 +1,301 @@
+:root {
+  color-scheme: light dark;
+  --background: light-dark(#f7f8fa, #111317);
+  --card: light-dark(#fff, #1b1e24);
+  --foreground: light-dark(#202124, #e8eaed);
+  --muted: light-dark(#5f6368, #9aa0a6);
+  --border: light-dark(#dadce0, #3c4043);
+  --primary: #4f7cff;
+  --primary-hover: #416ee8;
+  --error-bg: light-dark(#fce8e6, #4c1d1a);
+  --error: light-dark(#a50e0e, #f28b82);
+  font-family: system-ui, sans-serif;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+body {
+  background: var(--background);
+  color: var(--foreground);
+  margin: 0;
+  min-height: 100vh;
+}
+
+button,
+input {
+  font: inherit;
+}
+
+button {
+  background: var(--primary);
+  border: 0;
+  border-radius: 8px;
+  color: white;
+  cursor: pointer;
+  font-weight: 600;
+  padding: 10px 16px;
+}
+
+button:hover {
+  background: var(--primary-hover);
+}
+
+button:disabled {
+  cursor: default;
+  opacity: .6;
+}
+
+button.secondary {
+  background: transparent;
+  border: 1px solid var(--border);
+  color: var(--foreground);
+}
+
+.brand {
+  font-size: 20px;
+  font-weight: 750;
+  letter-spacing: -.04em;
+}
+
+.muted {
+  color: var(--muted);
+}
+
+.mono {
+  font-family: ui-monospace, monospace;
+}
+
+.error {
+  background: var(--error-bg);
+  border: 1px solid color-mix(in srgb, var(--error), transparent 60%);
+  border-radius: 8px;
+  color: var(--error);
+  margin: 16px 0;
+  padding: 12px 14px;
+}
+
+.login-page {
+  align-items: center;
+  display: flex;
+  justify-content: center;
+  padding: 32px;
+}
+
+.login-card {
+  background: var(--card);
+  border: 1px solid var(--border);
+  border-radius: 16px;
+  box-shadow: 0 16px 40px rgba(0, 0, 0, .15);
+  max-width: 420px;
+  padding: 32px;
+  width: 100%;
+}
+
+.login-card h1 {
+  font-size: 24px;
+  margin: 20px 0 4px;
+}
+
+.login-card form,
+.login-card label {
+  display: grid;
+  gap: 8px;
+}
+
+.login-card form {
+  gap: 16px;
+  margin-top: 24px;
+}
+
+.login-card input {
+  background: var(--background);
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  color: var(--foreground);
+  padding: 11px 12px;
+}
+
+.separator {
+  align-items: center;
+  color: var(--muted);
+  display: flex;
+  gap: 12px;
+  margin: 20px 0;
+}
+
+.separator::before,
+.separator::after {
+  border-top: 1px solid var(--border);
+  content: '';
+  flex: 1;
+}
+
+.provider-list {
+  display: grid;
+  gap: 10px;
+}
+
+.provider-list button {
+  background: transparent;
+  border: 1px solid var(--border);
+  color: var(--foreground);
+}
+
+.topbar {
+  align-items: center;
+  background: var(--card);
+  border-bottom: 1px solid var(--border);
+  display: flex;
+  height: 60px;
+  justify-content: space-between;
+  padding: 0 24px;
+}
+
+.app-shell {
+  display: grid;
+  grid-template-columns: 240px minmax(0, 1fr);
+  height: calc(100vh - 60px);
+}
+
+aside {
+  background: var(--card);
+  border-right: 1px solid var(--border);
+  overflow: auto;
+  padding: 20px 12px;
+}
+
+.aside-title {
+  color: var(--muted);
+  font-size: 12px;
+  font-weight: 700;
+  letter-spacing: .08em;
+  padding: 0 12px 10px;
+  text-transform: uppercase;
+}
+
+#workspace-nav {
+  display: grid;
+  gap: 4px;
+}
+
+.nav-item {
+  background: transparent;
+  color: var(--foreground);
+  overflow: hidden;
+  text-align: left;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.nav-item:hover,
+.nav-item.selected {
+  background: color-mix(in srgb, var(--primary), transparent 84%);
+}
+
+#content {
+  overflow: auto;
+  padding: 32px;
+}
+
+.page-heading {
+  align-items: center;
+  display: flex;
+  justify-content: space-between;
+  margin-bottom: 24px;
+}
+
+.page-heading h1,
+#workspace-overview h1 {
+  margin: 0;
+}
+
+.card-grid {
+  display: grid;
+  gap: 16px;
+  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
+  margin-top: 24px;
+}
+
+.workspace-card {
+  align-items: flex-start;
+  background: var(--card);
+  border: 1px solid var(--border);
+  color: var(--foreground);
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  min-height: 112px;
+  padding: 20px;
+  text-align: left;
+}
+
+.workspace-card:hover {
+  background: color-mix(in srgb, var(--card), var(--primary) 5%);
+  border-color: color-mix(in srgb, var(--primary), var(--border) 45%);
+}
+
+.workspace-card strong {
+  font-size: 17px;
+}
+
+.workspace-card span {
+  color: var(--muted);
+  font-family: ui-monospace, monospace;
+  font-size: 12px;
+}
+
+.connector-list {
+  display: grid;
+  gap: 12px;
+}
+
+.connector-card {
+  background: var(--card);
+  border: 1px solid var(--border);
+  border-radius: 10px;
+  padding: 18px;
+}
+
+.connector-header {
+  align-items: center;
+  display: flex;
+  justify-content: space-between;
+}
+
+.status {
+  border-radius: 999px;
+  font-size: 12px;
+  font-weight: 700;
+  padding: 4px 9px;
+}
+
+.status.online {
+  background: light-dark(#e6f4ea, #173b25);
+  color: light-dark(#137333, #81c995);
+}
+
+.status.offline {
+  background: light-dark(#f1f3f4, #303134);
+  color: var(--muted);
+}
+
+.connector-card dl {
+  display: grid;
+  font-size: 13px;
+  gap: 6px 16px;
+  grid-template-columns: max-content 1fr;
+  margin: 14px 0 0;
+}
+
+.connector-card dt {
+  color: var(--muted);
+}
+
+.connector-card dd {
+  margin: 0;
+  overflow-wrap: anywhere;
+}
+
+.empty-state {
+  border: 1px dashed var(--border);
+  border-radius: 10px;
+  color: var(--muted);
+  padding: 40px;
+  text-align: center;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+@media (max-width: 720px) {
+  .app-shell {
+    grid-template-columns: 1fr;
+  }
+
+  aside {
+    border-bottom: 1px solid var(--border);
+    border-right: 0;
+    max-height: 180px;
+  }
+
+  #content {
+    padding: 20px;
+  }
+}
