+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_GRIPS_GRIPS_AGENTSERVER_CLIENT_H_
+#define CHROME_BROWSER_UI_WEBUI_GRIPS_GRIPS_AGENTSERVER_CLIENT_H_
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/functional/callback_forward.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/values.h"
+#include "url/gurl.h"
+
+class Profile;
+
+namespace network {
+class SharedURLLoaderFactory;
+class SimpleURLLoader;
+}  // namespace network
+
+namespace grips {
+
+class AgentServerClient {
+ public:
+  struct Response {
+    Response();
+    Response(Response&&);
+    Response& operator=(Response&&);
+    ~Response();
+
+    int http_status = 0;
+    std::optional<base::Value> body;
+    std::string error;
+  };
+
+  using ResponseCallback = base::OnceCallback<void(Response)>;
+
+  explicit AgentServerClient(Profile* profile);
+  AgentServerClient(const AgentServerClient&) = delete;
+  AgentServerClient& operator=(const AgentServerClient&) = delete;
+  ~AgentServerClient();
+
+  const GURL& server_origin() const { return server_origin_; }
+
+  void Get(std::string_view path, ResponseCallback callback);
+  void Post(std::string_view path,
+            base::Value::Dict body,
+            ResponseCallback callback);
+  void PostEmpty(std::string_view path, ResponseCallback callback);
+
+ private:
+  void StartRequest(std::string method,
+                    std::string_view path,
+                    std::optional<std::string> upload_body,
+                    ResponseCallback callback);
+  void OnRequestComplete(network::SimpleURLLoader* loader,
+                         ResponseCallback callback,
+                         std::optional<std::string> body);
+
+  GURL server_origin_;
+  scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory_;
+  std::map<network::SimpleURLLoader*,
+           std::unique_ptr<network::SimpleURLLoader>>
+      loaders_;
+};
+
+}  // namespace grips
+
+#endif  // CHROME_BROWSER_UI_WEBUI_GRIPS_GRIPS_AGENTSERVER_CLIENT_H_
diff --git a/chrome/browser/ui/webui/grips/grips_agentserver_client.cc b/chrome/browser/ui/webui/grips/grips_agentserver_client.cc
new file mode 100644
index 0000000..e6388aa
--- /dev/null
+++ b/chrome/browser/ui/webui/grips/grips_agentserver_client.cc
@@ -0,0 +1,174 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/grips/grips_agentserver_client.h"
+
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_util.h"
+#include "base/time/time.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/common/url_constants.h"
+#include "content/public/browser/storage_partition.h"
+#include "net/base/load_flags.h"
+#include "net/base/net_errors.h"
+#include "net/cookies/site_for_cookies.h"
+#include "net/http/http_request_headers.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "url/origin.h"
+#include "url/url_constants.h"
+
+namespace grips {
+namespace {
+
+constexpr char kServerUrlSwitch[] = "grips-server-url";
+constexpr int64_t kMaxResponseBytes = 1024 * 1024;
+constexpr base::TimeDelta kRequestTimeout = base::Seconds(30);
+
+GURL GetConfiguredServerOrigin() {
+  GURL configured(chrome::kGripsDefaultServerUrl);
+  const std::string override_url =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          kServerUrlSwitch);
+  if (!override_url.empty()) {
+    GURL candidate(override_url);
+    if (candidate.is_valid() && candidate.SchemeIs(url::kHttpsScheme) &&
+        !candidate.has_username() && !candidate.has_password()) {
+      configured = candidate;
+    }
+  }
+  return url::Origin::Create(configured).GetURL();
+}
+
+const net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("grips_agentserver_client", R"(
+      semantics {
+        sender: "Grips AgentServer Client"
+        description:
+          "Connects the built-in grips pages to the user's configured "
+          "AgentServer in order to authenticate and manage workspaces and "
+          "connectors."
+        trigger:
+          "The user opens a grips page or performs an action on that page."
+        data:
+          "The user's AgentServer session cookie and data explicitly entered "
+          "or requested by the user, such as login credentials, workspace "
+          "identifiers, and connector metadata."
+        destination: OTHER
+      }
+      policy {
+        cookies_allowed: YES
+        cookies_store: "user"
+        setting:
+          "This feature is only used when the user opens a grips page. The "
+          "AgentServer endpoint can be configured by the browser distributor."
+        policy_exception_justification:
+          "No enterprise policy is available in the first implementation."
+      })");
+
+}  // namespace
+
+AgentServerClient::Response::Response() = default;
+AgentServerClient::Response::Response(Response&&) = default;
+AgentServerClient::Response& AgentServerClient::Response::operator=(
+    Response&&) = default;
+AgentServerClient::Response::~Response() = default;
+
+AgentServerClient::AgentServerClient(Profile* profile)
+    : server_origin_(GetConfiguredServerOrigin()),
+      url_loader_factory_(profile->GetDefaultStoragePartition()
+                              ->GetURLLoaderFactoryForBrowserProcess()) {}
+
+AgentServerClient::~AgentServerClient() = default;
+
+void AgentServerClient::Get(std::string_view path,
+                            ResponseCallback callback) {
+  StartRequest("GET", path, std::nullopt, std::move(callback));
+}
+
+void AgentServerClient::Post(std::string_view path,
+                             base::Value::Dict body,
+                             ResponseCallback callback) {
+  std::string json;
+  base::JSONWriter::Write(body, &json);
+  StartRequest("POST", path, std::move(json), std::move(callback));
+}
+
+void AgentServerClient::PostEmpty(std::string_view path,
+                                  ResponseCallback callback) {
+  StartRequest("POST", path, std::nullopt, std::move(callback));
+}
+
+void AgentServerClient::StartRequest(
+    std::string method,
+    std::string_view path,
+    std::optional<std::string> upload_body,
+    ResponseCallback callback) {
+  GURL request_url = server_origin_.Resolve(path);
+  if (!request_url.is_valid() ||
+      url::Origin::Create(request_url) != url::Origin::Create(server_origin_)) {
+    Response response;
+    response.error = "Invalid AgentServer request URL";
+    std::move(callback).Run(std::move(response));
+    return;
+  }
+
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = request_url;
+  request->method = std::move(method);
+  request->load_flags = net::LOAD_DISABLE_CACHE;
+  request->credentials_mode = network::mojom::CredentialsMode::kInclude;
+  request->redirect_mode = network::mojom::RedirectMode::kError;
+  request->site_for_cookies = net::SiteForCookies::FromUrl(server_origin_);
+  request->request_initiator = url::Origin::Create(
+      GURL("grips://workspaces"));
+  request->headers.SetHeader(net::HttpRequestHeaders::kAccept,
+                             "application/json");
+
+  auto loader = network::SimpleURLLoader::Create(std::move(request),
+                                                  kTrafficAnnotation);
+  loader->SetAllowHttpErrorResults(true);
+  loader->SetTimeoutDuration(kRequestTimeout);
+  if (upload_body.has_value()) {
+    loader->AttachStringForUpload(std::move(*upload_body),
+                                  "application/json");
+  }
+
+  network::SimpleURLLoader* raw_loader = loader.get();
+  loaders_.emplace(raw_loader, std::move(loader));
+  raw_loader->DownloadToString(
+      url_loader_factory_.get(),
+      base::BindOnce(&AgentServerClient::OnRequestComplete,
+                     base::Unretained(this), raw_loader,
+                     std::move(callback)),
+      kMaxResponseBytes);
+}
+
+void AgentServerClient::OnRequestComplete(
+    network::SimpleURLLoader* raw_loader,
+    ResponseCallback callback,
+    std::optional<std::string> body) {
+  auto it = loaders_.find(raw_loader);
+  CHECK(it != loaders_.end());
+  std::unique_ptr<network::SimpleURLLoader> loader = std::move(it->second);
+  loaders_.erase(it);
+
+  Response response;
+  if (loader->ResponseInfo() && loader->ResponseInfo()->headers) {
+    response.http_status = loader->ResponseInfo()->headers->response_code();
+  }
+  if (loader->NetError() != net::OK) {
+    response.error = net::ErrorToString(loader->NetError());
+    std::move(callback).Run(std::move(response));
+    return;
+  }
+
+  if (body.has_value() && !body->empty()) {
+    response.body = base::JSONReader::Read(*body);
+    if (!response.body.has_value()) {
+      if (response.http_status >= 200 && response.http_status < 300) {
+        response.error = "AgentServer returned invalid JSON";
+      } else {
+        response.error = base::CollapseWhitespaceASCII(*body, true);
+        if (response.error.size() > 512) {
+          response.error.resize(512);
+        }
+      }
+    }
+  }
+  std::move(callback).Run(std::move(response));
+}
+
+}  // namespace grips
