source_set("grips") {
  sources = [
    "grips_ui.cc",
    "grips_ui.h",
    "grips_url_handler.cc",
    "grips_url_handler.h",
  ]

  public_deps = [
    "//content/public/browser",
    "//ui/webui",
  ]

  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui",
    "//chrome/browser/resources/grips:resources",
    "//chrome/common",
    "//net",
    "//services/network/public/mojom",
    "//services/network/public/cpp",
    "//ui/base",
    "//url",
  ]
}

if (!is_android) {
  source_set("browser_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
    sources = [ "grips_ui_browsertest.cc" ]
    deps = [
      ":grips",
      "//chrome/common",
      "//chrome/test:test_support",
      "//content/test:test_support",
      "//net",
      "//testing/gtest",
      "//url",
    ]
  }
}
