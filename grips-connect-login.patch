diff --git a/chrome/browser/resources/grips/login.ts b/chrome/browser/resources/grips/login.ts
new file mode 100644
--- /dev/null
+++ b/chrome/browser/resources/grips/login.ts
@@ -0,0 +1,33 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+const connectURL = 'https://connect.cs.ac.cn/';
+const button = document.querySelector<HTMLButtonElement>('#login');
+const status = document.querySelector<HTMLElement>('#status');
+
+function openConnect() {
+  // A top-level navigation is intentional: Connect's host-only cookies are
+  // stored in the normal Chromium profile and are then reused by the exam's
+  // standard OIDC authorization-code flow. An iframe would make this a
+  // third-party cookie and would be blocked by modern cookie policies.
+  window.location.replace(connectURL);
+}
+
+button?.addEventListener('click', openConnect);
+
+// Match the browser's normal sign-in affordance: opening grips://login starts
+// the Connect flow immediately, while leaving a button for blocked scripts or
+// users who want to retry after a transient network failure. The `manual`
+// query is used by browser tests to keep the WebUI document committed.
+if (!new URLSearchParams(window.location.search).has('manual')) {
+  window.setTimeout(() => {
+    if (document.visibilityState === 'visible') {
+      openConnect();
+    }
+  }, 100);
+}
+
+if (status) {
+  status.textContent = 'Connect login opens in this tab; after signing in, open an exam link.';
+}
diff --git a/chrome/browser/ui/webui/grips/grips_ui.h b/chrome/browser/ui/webui/grips/grips_ui.h
--- a/chrome/browser/ui/webui/grips/grips_ui.h
+++ b/chrome/browser/ui/webui/grips/grips_ui.h
@@ -17,4 +17,19 @@ class GripsExamUI : public ui::MojoWebUIController {
   WEB_UI_CONTROLLER_TYPE_DECL();
 };
+
+// The BYOD account entry point. It is deliberately separate from
+// Chromium's GAIA/Google identity stack: a top-level Connect navigation
+// stores the Connect host-only cookie in the user's normal profile, and the
+// exam later reuses that session through standard OIDC SSO.
+class GripsLoginUI : public ui::MojoWebUIController {
+ public:
+  explicit GripsLoginUI(content::WebUI* web_ui);
+  GripsLoginUI(const GripsLoginUI&) = delete;
+  GripsLoginUI& operator=(const GripsLoginUI&) = delete;
+  ~GripsLoginUI() override;
+
+ private:
+  WEB_UI_CONTROLLER_TYPE_DECL();
+};
 
 #endif  // CHROME_BROWSER_UI_WEBUI_GRIPS_GRIPS_UI_H_
diff --git a/chrome/browser/ui/webui/grips/grips_ui.cc b/chrome/browser/ui/webui/grips/grips_ui.cc
--- a/chrome/browser/ui/webui/grips/grips_ui.cc
+++ b/chrome/browser/ui/webui/grips/grips_ui.cc
@@ -486,1 +486,21 @@ WEB_UI_CONTROLLER_TYPE_IMPL(GripsExamUI)
 WEB_UI_CONTROLLER_TYPE_IMPL(GripsExamUI)
+
+GripsLoginUI::GripsLoginUI(content::WebUI* web_ui)
+    : ui::MojoWebUIController(web_ui, /*enable_chrome_send=*/false) {
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      Profile::FromWebUI(web_ui), chrome::kGripsLoginHost);
+  source->SetSupportedScheme(chrome::kGripsScheme);
+  webui::SetupWebUIDataSource(source, kGripsResources,
+                              IDR_GRIPS_LOGIN_HTML);
+
+  // login.ts performs a top-level navigation to Connect. Keep the page's
+  // script and stylesheet scoped to the trusted login origin; Connect itself
+  // is a normal HTTPS page after the navigation commits.
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ScriptSrc,
+      "script-src grips://login 'self';");
+}
+
+GripsLoginUI::~GripsLoginUI() = default;
+
+WEB_UI_CONTROLLER_TYPE_IMPL(GripsLoginUI)
