+#include "ui/webui/webui_util.h"
+
+namespace {
+
+void SetupSource(Profile* profile, const char* host, int default_resource) {
+  content::WebUIDataSource* source =
+      content::WebUIDataSource::CreateAndAdd(profile, host);
+  source->SetSupportedScheme(chrome::kGripsScheme);
+  webui::SetupWebUIDataSource(source, kGripsResources, default_resource);
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ConnectSrc, "connect-src 'none';");
+}
+
+}  // namespace
+
+GripsLoginUI::GripsLoginUI(content::WebUI* web_ui)
+    : ui::MojoWebUIController(web_ui) {
+  SetupSource(Profile::FromWebUI(web_ui), chrome::kGripsLoginHost,
+              IDR_GRIPS_LOGIN_HTML);
+}
+
+GripsLoginUI::~GripsLoginUI() = default;
+
+WEB_UI_CONTROLLER_TYPE_IMPL(GripsLoginUI)
+
+void GripsLoginUI::BindInterface(
+    mojo::PendingReceiver<grips::mojom::LoginPageHandlerFactory> receiver) {
+  factory_receiver_.reset();
+  factory_receiver_.Bind(std::move(receiver));
+}
+
+void GripsLoginUI::CreatePageHandler(
+    mojo::PendingReceiver<grips::mojom::LoginPageHandler> handler) {
+  page_handler_ = std::make_unique<grips::LoginPageHandler>(
+      std::move(handler), Profile::FromWebUI(web_ui()),
+      web_ui()->GetWebContents());
+}
+
+GripsWorkspacesUI::GripsWorkspacesUI(content::WebUI* web_ui)
+    : ui::MojoWebUIController(web_ui) {
