+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+module grips.mojom;
+
+struct ApiError {
+  int32 status;
+  string message;
+};
+
+struct LoginConfig {
+  array<string> providers;
+  bool password_auth;
+  string server_origin;
+};
+
+struct Workspace {
+  string id;
+  string name;
+  string created_at;
+  string updated_at;
+};
+
+struct Connector {
+  string exe_id;
+  string name;
+  string description;
+  bool is_default;
+  bool is_online;
+  string last_seen_at;
+  string client_ip;
+  string os;
+  string codex_version;
+  string connected_at;
+  string disconnected_at;
+};
+
+interface LoginPageHandlerFactory {
+  CreatePageHandler(pending_receiver<LoginPageHandler> handler);
+};
+
+interface LoginPageHandler {
+  GetLoginConfig() => (LoginConfig config, ApiError? error);
+  CheckSession() =>
+      (bool authenticated, string email, ApiError? error);
+  Login(string email, string password) => (ApiError? error);
+  OpenOidcLogin(string provider) => (ApiError? error);
+};
+
+interface WorkspacesPageHandlerFactory {
+  CreatePageHandler(pending_receiver<WorkspacesPageHandler> handler);
+};
+
+interface WorkspacesPageHandler {
+  ListWorkspaces() => (array<Workspace> workspaces, ApiError? error);
+  ListConnectors(string workspace_id) =>
+      (array<Connector> connectors, ApiError? error);
+  Logout() => (ApiError? error);
+};
