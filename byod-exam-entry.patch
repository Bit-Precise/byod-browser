+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_GRIPS_GRIPS_URL_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_GRIPS_GRIPS_URL_HANDLER_H_
+
+class GURL;
+
+namespace content {
+class BrowserContext;
+}
+
+namespace grips {
+
+// Rewrites a public exam entry such as grips://exam.cs.ac.cn/course-101 to
+// the single browser-owned grips://exam/ WebUI. The HTTPS target is carried as
+// data; web content is never rendered under the privileged grips scheme.
+bool HandleGripsExamURL(GURL* url,
+                        content::BrowserContext* browser_context);
+
+}  // namespace grips
+
+#endif  // CHROME_BROWSER_UI_WEBUI_GRIPS_GRIPS_URL_HANDLER_H_
diff --git a/chrome/browser/ui/webui/grips/grips_url_handler.cc b/chrome/browser/ui/webui/grips/grips_url_handler.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/ui/webui/grips/grips_url_handler.cc
@@ -0,0 +1,66 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/grips/grips_url_handler.h"
+
+#include <string>
+
+#include "base/strings/escape.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_util.h"
+#include "chrome/common/url_constants.h"
+#include "url/gurl.h"
+#include "url/url_constants.h"
+
+namespace grips {
+namespace {
+
+GURL ErrorURL() {
+  return GURL(base::StrCat(
+      {chrome::kGripsExamUrl, "?error=invalid_exam_link"}));
+}
+
+bool IsValidPublicExamEntry(const GURL& url) {
+  if (!url.is_valid() || url.host() != chrome::kGripsTrustedExamHost ||
+      url.has_username() || url.has_password() || url.has_port() ||
+      url.has_ref()) {
+    return false;
+  }
+
+  // A concrete exam path is required. This deliberately rejects a bare
+  // domain so discovery cannot silently select an exam on the user's behalf.
+  return !url.path().empty() && url.path() != "/";
+}
+
+}  // namespace
+
+bool HandleGripsExamURL(GURL* url,
+                        content::BrowserContext* browser_context) {
+  if (!url || !url->SchemeIs(chrome::kGripsScheme)) {
+    return false;
+  }
+
+  // grips://exam/ is the one fixed privileged WebUI origin. Never rewrite it.
+  if (url->host() == chrome::kGripsExamHost) {
+    return false;
+  }
+
+  // The bare trusted exam origin opens the browser-owned exam-code screen.
+  // Do not manufacture an exam target until the student enters a valid code.
+  if (url->host() == chrome::kGripsTrustedExamHost &&
+      (url->path().empty() || url->path() == "/")) {
+    *url = GURL(chrome::kGripsExamUrl);
+    return true;
+  }
+
+  // Completion is a browser action and must stay in the current tab.
+  if (url->host() == chrome::kGripsTrustedExamHost &&
+      base::StartsWith(url->path(), "/exams/", base::CompareCase::SENSITIVE) &&
+      base::EndsWith(url->path(), "/complete", base::CompareCase::SENSITIVE)) {
+    const std::string path = url->path();
+    const std::string exam_id = path.substr(7, path.size() - 16);
+    if (exam_id.empty() || exam_id.find('/') != std::string::npos) {
+      *url = ErrorURL();
+      return true;
+    }
+    *url = GURL(base::StrCat({chrome::kGripsExamUrl,
+                              "?action=complete&exam_id=",
+                              base::EscapeQueryParamValue(exam_id, true)}));
+    return true;
+  }

+  if (!IsValidPublicExamEntry(*url)) {
+    *url = ErrorURL();
+    return true;
+  }
+
+  GURL::Replacements replacements;
+  replacements.SetSchemeStr(url::kHttpsScheme);
+  replacements.ClearRef();
+  const GURL target = url->ReplaceComponents(replacements);
+  if (!target.is_valid()) {
+    *url = ErrorURL();
+    return true;
+  }
+
+  *url = GURL(base::StrCat(
+      {chrome::kGripsExamUrl, "?target=",
+       base::EscapeQueryParamValue(target.spec(), true)}));
+  return true;
+}
+
+}  // namespace grips
